# Copy this file to .env and fill in ONE of the keys below.

# Option A: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY= ""

# Option B: Google Gemini - free tier (https://aistudio.google.com/apikey)
# Also run: uv add langchain-google-genai
# (langchain reads GOOGLE_API_KEY; GEMINI_API_KEY kept for the native google-genai SDK)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# OCR backend for upload / gold eval: docling | vlm
OCR_BACKEND=docling
VLM_MODEL_PATH=mlx-community/Qwen2-VL-2B-Instruct-4bit

# Docling corpus: data/baltimore-marriage-certificates/records.db + rag_index/
# VLM corpus:     data/baltimore-marriage-certificates/records_vlm.db + rag_index_vlm/
